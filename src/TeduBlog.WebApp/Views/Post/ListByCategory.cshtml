@model PostListByCategoryViewModel
@inject IOptions<SystemConfig> _config;
@{
    ViewData["Title"] = Model.Category.Name + "-"  + _config.Value.AppName;
    ViewData["Description"] = Model.Category.SeoDescription + "-" + _config.Value.AppName;
}
@inject IOptions<SystemConfig> _config;
<!-- Page Header-->
<!-- Page Header-->
<header class="masthead" style="background-image: url('/assets/img/home-bg.jpg')">
    <div class="container position-relative px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                <div class="site-heading">
                    <h1>@Model.Category.Name</h1>
                    <span class="subheading">@Model.Category.SeoDescription</span>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- Main Content-->
<div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">
            @foreach(var item in Model.Posts.Results)
            {
                <!-- Post preview-->
                <div class="post-preview">
                    <a href="@string.Format(UrlContst.PostsDetails, item.Slug)" title="item.Name">
                        <h2 class="post-title">@item.Name</h2>
                        <h3 class="post-subtitle">@item.Description</h3>
                    </a>
                    <p class="post-meta">
                        Posted by
                        <a href="@UrlContst.Author, item.AuthorUserName">@item.AuthorName</a>
                        @item.DateCreated.ToLongDateString()
                    </p>
                </div>
            }
            <div class="d-flex justify-content-end mb-4"><a class="btn btn-primary text-uppercase" href="@UrlContst.Posts">Older Posts →</a></div>
        </div>
    </div>
</div>